# Dockerfile.wordpress — Imagen WordPress sin root (spike FASE 0, PLAN-WORDPRESS-7-1).
#
# Capa fina sobre la imagen OFICIAL de WordPress (docker-library): el núcleo, las
# extensiones PHP (mysqli, gd, imagick, zip, intl, opcache, sodium...) y el
# entrypoint con soporte *_FILE son los oficiales; aquí solo se quita la necesidad
# de root:
#   - Apache escucha en 8080 (puerto >1024, sin CAP_NET_BIND_SERVICE).
#   - pid, lock, log y cache de Apache en rutas escribibles por el uid de servicio.
#   - Los logs van a stdout/stderr por descriptor, no por symlinks a /dev/std*.
# El usuario NUNCA invoca este Dockerfile a mano: `enola-cli wp create` lo extrae
# del binario y construye la imagen una sola vez si falta.
#
# Cadena de suministro: base pineada por digest (scripts/dev/refresh_image_digests.sh);
# al cambiarla, actualizar el tag `enola/wordpress:<ver>-php8.4` en src/domain/images.rs.
ARG WORDPRESS_IMAGE=wordpress:7.1.4-php8.4-apache@sha256:2b1ad6e3d7c036470c4c807dbcfdf490cfd70f3ad91fc009f61793ced96461bc
FROM ${WORDPRESS_IMAGE}

RUN set -eux; \
    sed -ri 's/^Listen 80$/Listen 8080/; s/^(\s*)Listen 443$/\1Listen 8443/' /etc/apache2/ports.conf; \
    sed -ri 's/<VirtualHost \*:80>/<VirtualHost *:8080>/' /etc/apache2/sites-available/*.conf; \
    # Sin User/Group: ya corre como el uid de servicio (Apache los ignora sin root).
    sed -ri '/^\s*(User|Group)\s/d' /etc/apache2/apache2.conf; \
    # Logs por descriptor (sin /dev/stdout como fichero) y sin ficheros bajo /var/log.
    sed -ri 's#\$\{APACHE_LOG_DIR\}/error\.log#/proc/self/fd/2#; s#\$\{APACHE_LOG_DIR\}/access\.log#/proc/self/fd/1#; s#\$\{APACHE_LOG_DIR\}/other_vhosts_access\.log#/proc/self/fd/1#' \
        /etc/apache2/apache2.conf /etc/apache2/sites-available/*.conf /etc/apache2/conf-available/*.conf; \
    rm -f /var/log/apache2/*.log; \
    mkdir -p /var/run/apache2 /var/lock/apache2; \
    # El uid real lo fija `enola-cli` (`--user`, el de `enola-wordpress`): no se puede
    # hornear en la imagen. Solo corre Apache en el contenedor, así que 1777 basta.
    chmod 1777 /var/run/apache2 /var/lock/apache2 /var/log/apache2

# Sin root. `enola-cli` lo sustituye por el usuario de sistema `enola-wordpress`
# (`--user uid:gid`, uid cualquiera); /var/www/html es el volumen y lo escribe ese uid.
USER 10001:10001
EXPOSE 8080
