[78.710648, "o", "\u001b[1;33m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n\r\n"]
[84.714261, "o", "\u001b[H\u001b[2J\u001b[3J"]
[84.714375, "o", "\u001b[1;32m\u001b[1m\u25b6 Paso 10: Eliminar servicio (cleanup)\u001b[0m\r\n\r\n"]
[84.714424, "o", "\u001b[1;36m\u276f \u001b[1msudo enola-cli tor remove demo-tor --force\u001b[0m\r\n\r\n"]
[85.856242, "o", "\ud83d\udd0d Checking Tor service status...\r\n"]
[85.860335, "o", "   tor@default status: active\r\n   \u2699\ufe0f  Trying: systemctl reload tor@default...\r\n"]
