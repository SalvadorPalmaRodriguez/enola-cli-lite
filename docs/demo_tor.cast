[28.434059, "o", "\r\n\u001b[1;33m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n\r\n"]
[34.437307, "o", "\u001b[H\u001b[2J\u001b[3J"]
[34.437341, "o", "\u001b[1;32m\u001b[1m\u25b6 Paso 3: Crear hidden service\u001b[0m\r\n\r\n\u001b[1;36m\u276f \u001b[1msudo enola-cli tor create --name demo-tor --service-type raw --virtual-port 80 --target-port 18080\u001b[0m\r\n\r\n"]
[35.554953, "o", "\ud83d\udce1 Creating RAW service (Tor \u2192 App directly)\r\n   \u2139\ufe0f  Use 'web' type for HTTP applications (includes Nginx proxy)\r\n"]
