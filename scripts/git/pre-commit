#!/usr/bin/env bash
# pre-commit — Verificaciones locales antes de cada commit.
#
#   1. Sincronización de versión (sync_version.sh --check)
#   2. cargo fmt --check
#   3. Coherencia de archivos de contexto IA (check 18)
#   4. Anti-leak operator en blobs staged (DOC-SEC-005)
#   5. Rutas privadas en el índice + .gitignore staged íntegro
#   6. Aviso temprano de advisories (cargo audit --no-fetch, NO bloqueante)
#
# Instalar:
#   bash scripts/git/install-hooks.sh

set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$PROJECT_ROOT"

# ─── 1. Sincronización de versión ──────────────────────────────────────
echo "🔍 Verificando sincronización de versión..."
if ! bash scripts/dev/sync_version.sh --check; then
    echo "" >&2
    echo "  Para saltarte esta comprobación (NO recomendado):" >&2
    echo "    git commit --no-verify" >&2
    exit 1
fi

# ─── 2. cargo fmt --check ─────────────────────────────────────────────
echo "🔍 Verificando formato (cargo fmt --check)..."
if ! cargo fmt --check 2>&1; then
    echo "" >&2
    echo "  ❌ cargo fmt encontró diferencias. Ejecuta 'cargo fmt' y re-commitea." >&2
    echo "  Para saltarte esta comprobación (NO recomendado):" >&2
    echo "    git commit --no-verify" >&2
    exit 1
fi
echo "  ✅ Formato correcto"

# ─── 3. Coherencia de archivos de contexto IA (check 18) ───────────────
echo "🔍 Verificando coherencia de docs IA (skills, frontmatter, índice)..."
if ! PROJECT_ROOT="$PROJECT_ROOT" bash docs/dev/audit/checks/18_ai_docs_sync.sh; then
    echo "" >&2
    echo "  ❌ Drift en archivos de contexto IA. Revisa y corrige." >&2
    exit 1
fi
echo "  ✅ Docs IA coherentes"

# ─── 4. Anti-leak operator en blobs staged (DOC-SEC-005) ───────────────
# Detecta términos operator-only en TODOS los ficheros staged.
# Se lee el blob del índice (git show ":file"), nunca el worktree:
# escanear el worktree producía falsos negativos (leak en índice pero
# borrado del worktree → pasaba) y falsos positivos (leak solo en
# worktree, nada staged → bloqueaba sin motivo).
OPERATOR_TERMS=(
    "appliance deploy"
    "enola-signup"
    "enola-billing"
    "btcpay"
    "invoiceninja"
    "invoice.ninja"
    "KEYCLOAK_ADMIN"
    "KC_DB_PASSWORD"
    "SMTP_PASSWORD"
    "SMTP_USERNAME"
    "renewals.timer"
    "renewal-reminder"
    "billing-webhook"
    "appliance email"
    "appliance renewals"
    "argon2"
    "rusqlite"
)

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM || true)

FOUND_LEAKS=0

while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    # Única exclusión: este propio hook contiene la lista OPERATOR_TERMS
    # (es el único fichero trackeado con esos términos); sin excluirlo se
    # autobloquearía al commitear cambios sobre sí mismo.
    [[ "$file" == "scripts/git/pre-commit" ]] && continue
    content=$(git show ":$file" 2>/dev/null) || continue
    for term in "${OPERATOR_TERMS[@]}"; do
        if printf '%s\n' "$content" | grep -qiI "$term"; then
            echo "❌ LEAK DETECTADO (staged): '$term' encontrado en $file" >&2
            FOUND_LEAKS=1
        fi
    done
done <<< "$STAGED_FILES"

# DOC-SEC-003: el binario no debe embeber docs internas
STAGED_DOCS_RS=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -E "src/cli/docs\.rs" || true)

if [[ -n "$STAGED_DOCS_RS" ]]; then
    if git show ":src/cli/docs.rs" 2>/dev/null | grep -q "docs/internal"; then
        echo "❌ LEAK DETECTADO: src/cli/docs.rs embebe contenido de docs/internal/" >&2
        FOUND_LEAKS=1
    fi
fi

if [[ "$FOUND_LEAKS" -ne 0 ]]; then
    echo "" >&2
    echo "  Referencia: docs/internal/DOC_PUBLICATION_POLICY.md" >&2
    echo "  Para saltarte esta comprobación (NO recomendado):" >&2
    echo "    git commit --no-verify" >&2
    exit 1
fi

# ─── 5. Rutas privadas en el índice + .gitignore staged íntegro ────────
# Defensa estructural anti-leak: si .gitignore se relaja alguna vez (p.ej.
# para un workflow puntual) o se usa `git add -f`/`git add -A`, rutas que
# JAMÁS deben publicarse podrían quedar staged. Este check bloquea el
# commit si CUALQUIER ruta staged casa con la lista canónica de privados —
# independiente del estado de .gitignore. La lista duplica la del check 23
# de la auditoría (docs/dev/audit/checks/23_private_paths.sh).
PRIVATE_GLOBS=(
    'NOTES.md'
    'MEGAPLAN-*.md'
    'AGENTS.md'
    '*/AGENTS.md'
    '.agents/*'
    'CLAUDE.md'
    '.claude/*'
    'docs/dev/*'
    'scripts/dev/*'
    'tests/*'
    'feed/minisign.key'
    'security-audit/*'
    '.forgejo/*'
    'PROJECT_CONTEXT.md'
    '.ai_context/*'
    '.cargo/config.toml'
    '.devinignore'
    '.codeiumignore'
    '.windsurfignore'
)

PRIVATE_STAGED=0
while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    # Las dos plantillas .yml de ISSUE_TEMPLATE son públicas a propósito.
    if [[ "$file" == .github/ISSUE_TEMPLATE/* ]]; then
        [[ "$file" == ".github/ISSUE_TEMPLATE/bug_report.yml" \
        || "$file" == ".github/ISSUE_TEMPLATE/config.yml" ]] && continue
        echo "❌ RUTA PRIVADA staged: $file (plantilla de issue interna)" >&2
        PRIVATE_STAGED=1
        continue
    fi
    for glob in "${PRIVATE_GLOBS[@]}"; do
        if [[ "$file" == $glob ]]; then
            echo "❌ RUTA PRIVADA staged: $file (casa con '$glob')" >&2
            PRIVATE_STAGED=1
            break
        fi
    done
done <<< "$STAGED_FILES"

# Si .gitignore está staged, verificar que el BLOB staged conserva los
# patrones privados (el worktree podría estar restaurado pero el índice no).
if printf '%s\n' "$STAGED_FILES" | grep -qx '.gitignore'; then
    STAGED_GI="$(git show ':.gitignore' 2>/dev/null || true)"
    for pat in 'NOTES.md' 'MEGAPLAN-*.md' '**/AGENTS.md' '.agents/' \
               'CLAUDE.md' '.claude/' 'docs/dev/' 'scripts/dev/' 'tests/' \
               'feed/minisign.key' 'security-audit/' '.forgejo/' \
               '.cargo/config.toml' '.github/ISSUE_TEMPLATE/*' '.devinignore'; do
        if ! printf '%s\n' "$STAGED_GI" | grep -Fxq "$pat"; then
            echo "❌ .gitignore staged elimina el patrón privado: '$pat'" >&2
            PRIVATE_STAGED=1
        fi
    done
fi

if [[ "$PRIVATE_STAGED" -ne 0 ]]; then
    echo "" >&2
    echo "  Rutas privadas no se publican NUNCA. Para sacar del índice:" >&2
    echo "    git rm --cached <ruta>" >&2
    echo "  Si la publicación es deliberada (raro): git commit --no-verify" >&2
    exit 1
fi
echo "  ✅ Sin rutas privadas en el índice"

# ─── 6. Aviso temprano de advisories (NO bloqueante) ───────────────────
# El gate autoritativo es `pre-push` (run_all.sh --strict, check 14), que
# hace fetch completo de la advisory DB. Aquí solo se avisa pronto usando
# la DB ya cacheada (--no-fetch): sin red y sin latencia en cada commit.
# NUNCA bloquea: un advisory publicado upstream no debe impedir commitear
# trabajo local en curso — eso lo frena el push.
if command -v cargo-audit &>/dev/null; then
    echo "🔍 Advisories de dependencias (aviso temprano, no bloqueante)..."
    if AUDIT_OUT=$(cargo audit --no-fetch 2>&1); then
        echo "  ✅ Sin vulnerabilidades conocidas (DB local cacheada)"
    elif printf '%s\n' "$AUDIT_OUT" | grep -qE "^Crate:"; then
        echo "  ⚠️  cargo audit reporta vulnerabilidades — el PUSH sí se bloqueará:" >&2
        printf '%s\n' "$AUDIT_OUT" | grep -E "^(Crate|ID|Severity|Solution):" >&2 || true
        echo "" >&2
        echo "     Fix habitual (transitiva):  cargo update -p <crate>" >&2
        echo "     Este commit NO se bloquea." >&2
    else
        echo "  ℹ️  DB local ausente u obsoleta (--no-fetch): no evaluado aquí." >&2
        echo "     Se verificará de forma autoritativa en pre-push." >&2
    fi
fi

exit 0
